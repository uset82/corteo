# Token fijo de corteo. 43 caracteres en base64url. Genera uno con:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OPENCHATCUT_MCP_TOKEN=
# Solo DeepSeek Harness, Ollama y LM Studio. Las rutas de pago responden 403.
OPENCHATCUT_PROVIDERS=off
# Solo para el túnel opcional. npm run corteo:local no lo necesita.
# OPENCHATCUT_ALLOWED_HOSTS=corteo.uset82.workers.dev
# Whisper local. Un valor guardado en Ajustes gana sobre esta línea.
PREFERRED_TRANSCRIPTION_PROVIDER=local
# Memoria del servidor, en MB. 6144 son 6 GB.
OPENCHATCUT_DEV_HEAP_MB=6144
# Sin GPU (WSL o una VM): descomenta la línea siguiente.
# CC_RENDER_GL=swangle
# Oído real: una sola llamada de pago a OpenRouter por canción, apagada por defecto.
# OPENCHATCUT_LISTEN_RELAY=openrouter
# OPENROUTER_API_KEY=
# LISTEN_RELAY_MODEL=google/gemini-3.8-flash
# LISTEN_RELAY_CROSS_CHECK_MODEL=
