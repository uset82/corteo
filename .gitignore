# ── Private workspace (ignored since 2026-07-18) ──────────────
# AI assistant session configuration, skills, and hooks.
# AGENTS.md and docs/plans/ are tracked on purpose: every coding agent works from them.
CLAUDE.md
.codex/
.agents/
.claude/
# Impeccable design-hook state and configuration
.impeccable/
.browser4-cli/
# Local model-optimization plan / notes (was mistakenly committed; keep out of the public repo)
MODEL-OPT-PLAN.md
/MODEL-OPT-PLAN*/
*.opt-plan.md

# Keep local and temporary check scripts out of the repository; stable regressions use *.verify.* via npm test.
*.check.ts
*.check.mjs
# Keep the external MCP bridge protocol regression with its implementation; the legacy name is intentional.
!server/external-agent/broker.check.ts

# Local development and verification scripts.
# `/scripts/*` rather than `/scripts/`: git never re-includes files inside an
# ignored DIRECTORY, so with the old form every `!` line below was inert and
# new canonical scripts could only enter the repo via `git add -f` — a new
# scripts/*.verify.mjs registered in package.json was silently skipped by
# `git add -A`, and CI died with MODULE_NOT_FOUND on a file that exists locally.
/scripts/*
# DeepSeek Harness scripts get their own tracked folder; `*` above does not
# descend into it, so this one line re-includes every file inside.
!/scripts/harness/
!/scripts/editor-host.mjs
!/scripts/claudia-local.mjs
!/scripts/claudia-local.sh
!/scripts/claudia-install.sh
!/scripts/claudia-acceptance.sh
!/scripts/corteo
!/scripts/corteo-env.sh
!/scripts/tunnel.mjs
!/scripts/sync-mediapipe.mjs
# Stable regressions are *.verify.* by convention (see the *.check.* rule
# above), so they are never local-only.
!/scripts/*.verify.mjs

# Local marketing assets and drafts
/marketing/
.pi-*
node_modules
public/mediapipe/
public/whisper-cli/


# Local npm cache
.npm-cache/
# Root-level local runtime files
/etc/

# Agent tooling local state (Command Code taste captures)
.commandcode/
